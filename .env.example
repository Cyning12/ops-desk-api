# ops-desk-api 环境变量全集（复制为 .env 后填真实值，禁止提交 .env）
#
# 本地：`make dev` / uvicorn 直接读本文件（pydantic Settings + ``load_dotenv`` 进 os.environ）。
# tracing / reranker 用 os.getenv，必须靠 load_dotenv；只写进 Settings 不够。
# 生产：真值在服务器 `/opt/ops-desk/.env`，但容器只吃
#   ops-desk-workspace/deploy/docker-compose.prod.yml → api.environment 里声明过的键。
#   只改生产 .env、不改 compose 透传 = 容器里看不到。
# 生产示例另见：ops-desk-workspace/deploy/.env.example

# --- App（pydantic Settings 字段，环境变量名 = 字段名大写） ---
# APP_NAME=ops-desk-api
# DEBUG=false                 # 打开会走 FastAPI 调试路径；生产保持 false
# DATABASE_ECHO=false         # 打印每条 SQL；排查用，生产必须 false（刷日志 + 泄露参数）

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ops:ops_password@localhost:5432/opsdesk
# 生产 compose 用 DB_PASSWORD 拼 DATABASE_URL；本地 make dev 不需要这项
# DB_PASSWORD=

# --- Auth / Cookie ---
OPS_DESK_SECRET=change-me-in-production
OPS_DESK_AUTH_MODE=db
# SESSION_COOKIE_NAME=ops_session
# SESSION_TTL_HOURS=168
# 生产必须 true（HTTPS）；本地 false
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_PATH=/

# --- Admin sync（GHA 机读 Bearer） ---
# 空=仅 cookie maintainer；非空则 POST /api/ops/admin/sync 可用 Authorization: Bearer
OPS_ADMIN_SYNC_TOKEN=

# --- CORS ---
# 本地 Vue；生产 https://www.cynaya.cn
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chat ---
# 生产必须 false（未鉴权演示通道）
OPS_CHAT_WS_ENABLED=true

# --- LLM（Chat 默认） ---
OPS_LLM_PROVIDER=siliconflow
# 空则用 model_catalog 默认（siliconflow 列表首项，默认 DeepSeek-V4-Flash）
# OPS_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 可选：覆盖 SiliconFlow 可选模型列表（逗号分隔 id；可选 id|显示名）。空/非法 → 代码默认列表
# SILICONFLOW_MODELS=deepseek-ai/DeepSeek-V4-Flash,deepseek-ai/DeepSeek-V4-Pro,Qwen/Qwen3.6-27B

# --- LLM 韧性（llm-layer-hardening · 非法值回退默认 + warning）---
# 传输重试：指数退避+抖动，仅 retryable 错误类；流中已吐正文后零重试
# OPS_LLM_RETRY_ENABLED=true          # false = 现网逐字节一致
# OPS_LLM_RETRY_MAX_ATTEMPTS=3        # 总尝试次数（含首次）
# OPS_LLM_RETRY_BASE_DELAY_S=0.5
# OPS_LLM_RETRY_MAX_DELAY_S=8.0
# provider 级熔断：连续 fail_max 次环境失败跳闸 60s（open 零出网 circuit_open）
# OPS_LLM_CB_ENABLED=true
# OPS_LLM_CB_FAIL_MAX=5
# OPS_LLM_CB_RESET_TIMEOUT=60
# 任务分档路由（answer/grader/extract/structured；须为已知目录内模型 id）
# OPS_LLM_TIER_ANSWER_MODEL=
# OPS_LLM_TIER_GRADER_MODEL=          # 优先于旧 RAG_GRADER_MODEL
# OPS_LLM_TIER_EXTRACT_MODEL=
# OPS_LLM_TIER_STRUCTURED_MODEL=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-xxxxxxxx
# 可选 fallback provider（生产默认不用）
BAILIAN_API_KEY=sk-xxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# --- RAG 向量 / Qdrant ---
# 本地默认 qdrant；生产切流前曾默认 pgvector，现网切读后为 qdrant
RAG_VECTOR_BACKEND=qdrant
RAG_QDRANT_SHADOW_WRITE=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ops_knowledge
# QDRANT_API_KEY=
# 查询期 HNSW ef（越小越快、召回略降）；未设时代码默认 30
# QDRANT_HNSW_EF=30

# --- RAG 关键词路 ---
RAG_FTS_CONFIG=simple
RAG_KW_EXPAND=false
# RAG_SECOND_PATH=fts
# RAG_SPARSE_MODEL=BAAI/bge-m3
# RAG_SPARSE_FP16=false

# --- RAG 查询嵌入（生产推荐远程，消本地 bge-m3 冷启动） ---
# siliconflow=远程 POST /embeddings（默认，含空/未设）；local=本机 SentenceTransformer（仅本机有内存时）
RAG_EMBED_BACKEND=siliconflow
# RAG_EMBED_MODEL=BAAI/bge-m3

# --- RAG 精排（生产推荐开；金样对照须关） ---
RAG_RERANK_ENABLED=true
# siliconflow=远程 POST /rerank（默认，含空/未设）；local=本机 CrossEncoder（仅本机有内存时）
RAG_RERANK_BACKEND=siliconflow
# 每路召回的条数（仅 rerank 开启时生效；关闭时保持现网 10）
# RAG_RECALL_K_EACH=20
RAG_RERANK_MIN_SCORE=0.4
RAG_RERANK_SCORE_RATIO=0.75
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANK_CANDIDATES=20

# --- RAG grader / LC Evidence answer ---
RAG_GRADER_PROMPT=v1
RAG_GRADER_PROVIDER=siliconflow
RAG_GRADER_MODEL=Qwen/Qwen3.6-27B
# RAG_LC_ANSWER_PROVIDER=siliconflow
# RAG_LC_ANSWER_MODEL=
# RAG_LC_ANSWER_PROMPT=v1

# --- HuggingFace（生产机访问不了 huggingface.co） ---
# 只写 .env 不够：compose 必须透传同名键。权重建议挂 volume，避免 recreate 再拉。
# 生产推荐镜像站；有本地缓存后可改 HF_HUB_OFFLINE=1
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
# HF_HOME=/root/.cache/huggingface

# --- Langfuse（可选；Chat / LC Evidence 共用 OPS_CHAT_TRACER） ---
# OPS_CHAT_TRACER=langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# 兼容别名：LANGFUSE_BASE_URL 未设时回落到它（SDK 旧名）
# LANGFUSE_HOST=
# 仓内键；会**同步写回** SDK 的 LANGFUSE_TRACING_ENVIRONMENT。默认 prod；本机请写 dev
LANGFUSE_ENV=prod
# SDK 原生名。代码会读它作为回落值（LANGFUSE_ENV 优先），随后又会被 LANGFUSE_ENV 的值覆盖回去
# LANGFUSE_TRACING_ENVIRONMENT=
# LANGFUSE_TRACING=false
# 线上规则分采样率（0.0–1.0）；默认 0=关闭。见 docs/spec/agent-infra/eval/GUIDE_online_sample_annotation_v0.md
# OPS_EVAL_SCORE_SAMPLE_RATE=0
# Langfuse Generation 正文 I/O 截断字符数（默认 4000）
# OPS_LANGFUSE_IO_TRUNCATE=4000

# --- Capability · 真 MCP client（U3；默认关 · CI 不外网） ---
# OPS_CAPABILITY_MCP_ENABLED=false
# OPS_CAPABILITY_MCP_ENDPOINT=http://127.0.0.1:8080/mcp
# OPS_CAPABILITY_MCP_DEFAULT_TOOL=echo

# --- Capability 治理（P0–P2 · 全部可选，不设即用安全默认） ---
#
# 防重 / 回执落库：空=null（**不落库，不可上生产**） | memory（进程内，重启即丢） | db（跨实例）
# ⚠️ 只有 db 算 production-safe；同步 invoke 在 db 模式下会 fail-closed（红线 R8）
# OPS_CAPABILITY_PERSISTENCE=db

# 额外能力清单：**逗号分隔的 YAML 路径**。刻意不做目录扫描——不显式列出就不加载。
# OPS_CAPABILITY_EXTRA_MANIFESTS=./manifests/extra_a.yaml,./manifests/extra_b.yaml

# 会话配额（**按 run_id 分桶**，不是按 subtask——按 subtask 分桶永远打不满 = 假门）
# OPS_CAPABILITY_MAX_CALLS_PER_SESSION=64
# OPS_CAPABILITY_MAX_WRITES_PER_SESSION=8

# 全局停用：**逗号分隔的匹配模式列表，不是布尔开关**。空 = 不停用。
# 例：`*` = 全部停用；`oa.ticket.*` = 停用该前缀
# OPS_CAPABILITY_KILL_SWITCH=

# 参数校验：强制**所有**能力都过 args_schema（默认只对写能力 / manifest 自己要求时校验）
# OPS_CAPABILITY_FORCE_ARGS_SCHEMA=false

# 危险形态放行。默认**全拒**；打开任意一个都等于拆掉对应闸门，改前想清楚。
# 布尔取值只认 1 / true / yes
# OPS_CAPABILITY_ALLOW_HIGH_RISK=false
# OPS_CAPABILITY_ALLOW_WRITE=false
# OPS_CAPABILITY_ALLOW_SANDBOX=false
# OPS_CAPABILITY_ALLOW_CLI=false

# 下游熔断（**per capability** 三态，不是 per host）
# OPS_CAPABILITY_CB_ENABLED=1
# OPS_CAPABILITY_CB_BACKEND=mock-unavailable   # memory | redis | mock-unavailable（默认 mock-unavailable）
# OPS_CAPABILITY_CB_REDIS_URL=                 # backend=redis 时必填
# OPS_CAPABILITY_CB_FAIL_MAX=5                 # 连续失败多少次断开
# OPS_CAPABILITY_CB_RESET_TIMEOUT=60           # 断开多少秒后放行一次探测（half-open 是瞬时态，由调用驱动）
# OPS_CAPABILITY_CB_SUCCESS_THRESHOLD=1        # 探测成功几次才闭合
# OPS_CAPABILITY_CB_SCOPE=capability
# OPS_CAPABILITY_CB_HALFOPEN_WRITES=0          # 写能力是否允许半开探测（默认 0：写探测代价不对等，让读能力先探路）

# 凭证保险箱：清单里只写**凭证名**（如 `auth: OA_GATEWAY_TOKEN`），值放这里。
# 键名 = OPS_CAP_CRED_ + 凭证名（大写）。**值不进代码、不进清单、不进日志。**
# OPS_CAP_CRED_OA_GATEWAY_TOKEN=

# http 能力的出网代理（不设则用系统代理）
# OPS_CAPABILITY_HTTP_PROXY=

# --- HITL 审批（人在回路 · 三层拦截的第一层） ---
#
# 审批申请存储：空=null（**不落库，只打错误日志**） | memory（进程内，重启即丢） | db
# ⚠️ 不落库时「人在等一个不存在的审批」——界面上和「正在审批中」长得一样，极难排查
# OPS_HITL_PERSISTENCE=db

# 回调签名密钥（HMAC-SHA256，±300s 时间窗 + nonce 防重放）。
# **为空则回调端点拒绝一切请求**（不设密钥 = 不开放，宁可失败也不裸奔）。
# 必须与 mock-oa 的 mock-oa.agent.callback-secret 完全一致，否则回调恒定 401。
# OPS_HITL_CALLBACK_SECRET=

# --- 签发审批消费回路 / 测试能力波次 env（T1 消费门 · T2 自动恢复 · T3 候选追加 · D2 写放行） ---
# 全部可选：**不设 = 对 master 现状零 diff**（四键各自的安全默认即现状语义）。

# 批准消费 TTL（墙钟秒）：decide(approved) 后多久内可被消费/自动恢复
# （T1 消费门与 T2 补偿扫描共用这**单一旋钮**，不另开第二个）。
# 默认 3600；合法域 [1,86400]，非法/越界回退默认。读时判过期，不写回单据状态。
# OPS_HITL_APPROVAL_CONSUMPTION_TTL_SECONDS=3600

# 批准后自动恢复全局开关：manual（默认 · 现状零 diff：decide 后须人工再调 resume）| auto。
# 非法值回退 manual（fail-closed，打错误日志）。单据级可用 decide 载荷可选键
# resume_mode ∈ {inherit, immediate, manual} 覆盖（缺省 inherit=跟随本 env；未知值 400）。
# ⚠️ auto 安全口径：进程内触发器走与手动 resume **同一条恢复路径**（不载状态、禁 HTTP 自调）；
# 多副本防重靠 PG 行锁认领（FOR UPDATE SKIP LOCKED）+ 启动/周期补偿扫描兜底。
# OPS_HITL_AUTO_RESUME=manual

# strategy 候选 map env 追加口：逗号分隔候选 capability id（逐项 strip · 去空 · 保序去重），
# 在 map 解析结果（含未知 key 空列表）之后追加；覆盖口 CANDIDATE_CAPABILITY_IDS 生效时**不追加**。
# 默认不设 = 解析结果逐字节零 diff。
# 安全口径：env 只抬候选层，下游 ∩visible / deny 判序 / Policy 写闸全链不动（候选 ≠ 放行）。
# OPS_STRATEGY_EXTRA_CANDIDATE_CAPABILITY_IDS=testing.write.echo

# 写能力可见性放行 tag 白名单（逗号分隔 · D2 窄放行口径）：命中任一 tag 的能力
# **只豁免 deny_write 一层**；deny_high_risk 永不豁免（判序在其前，高危写恒裁）。
# 默认空 = 判序零 diff。⚠️ 生效时机：baseline_filter() 调用时读取，env 须在 import app 之前设置。
# OPS_CAPABILITY_ALLOW_WRITE_TAGS=testing

# --- lg-rag 挂起点 checkpointer（决定「批准之后能不能真的恢复」） ---
# 空 / 其他值 = 内存 saver；**只有 `postgres` 会挂 PG checkpointer**（是个开关，不是多后端选择）。
# ⚠️ 内存 saver 每请求新建 ⇒ 跨请求恢复**不可能成立**：
#    resume 端点会显式返回 503 拒绝，而不是假装恢复成功（这条是刻意的 fail-closed）。
# 升级 langgraph 前必看 docs/guides/RUNBOOK_local-acceptance_v1_zh.md §5。
# LG_RAG_HTTP_CHECKPOINTER=postgres

# --- 委派令牌验签门（Host V1-A · 三档 off|observe|enforce · 默认 off 零 diff） ---
# observe = 完整验签只记 would_block 不拦（灰度观察期）；enforce = 拒（前置：零误判观察报告 + SECRET 已配）。
# 本地观察 checklist：docs/guides/RUNBOOK_delegation_token_observe_local_v1_zh.md
# LG_RAG_DELEGATION_TOKEN_MODE=observe
# 签名密钥（HMAC · 生成：openssl rand -hex 32 · 禁硬编码 · 值禁入库 · 轮换=重启 api）
# LG_RAG_DELEGATION_TOKEN_SECRET=
# LG_RAG_DELEGATION_TOKEN_TTL_SECONDS=600     # 令牌墙钟 TTL（秒 · 禁续期）

# --- lg-rag / supervisor 预算（有界自主 · 每个自主循环都必须有） ---
# LG_RAG_SUPERVISOR_MAX_STEPS=32               # 内层总步预算（32 步是硬上限，别无限）
# LG_RAG_SUPERVISOR_MAX_WALL_SECONDS=0         # 墙钟上限（秒）；0 = 不限
# LG_RAG_REACT_MAX_ROUNDS=2                    # 外层 ReAct 轮次预算。**与步数是两个维度**，不能互相替代
# LG_RAG_REACT_SATISFACTION=0                  # 1 = 让**模型**判断「这一轮满足了吗」（多一次 LLM 调用）
# LG_RAG_MAX_RETRIES=2                         # rag 路径的评估-重写重试次数
# LG_RAG_STEP_CONTEXT_VALUE_CHARS=200          # 上游产出单个值的截断（合法区间 16–4000）
# LG_RAG_STEP_CONTEXT_BLOCK_CHARS=800          # 上游产出整块的截断（合法区间 64–16000）
# 被截断/挤掉的字段会记进 dropped_fields 报出来，不静默丢
# LG_RAG_ROUTER_PROVIDER=                      # 留空则跟随 OPS_LLM_PROVIDER
# LG_RAG_ROUTER_MODEL=                         # 留空则用 model_catalog 默认

# --- 数据同步脚本（app/ops/admin/sender · 不是服务运行必需） ---
# OPS_SYNC_REPO=                               # owner/name；留空用代码内置默认仓
# OPS_GRAPH_JSON_PATH=                         # 技术图谱 graph.json 路径（不传则用内置默认）
# OPS_SCAN_INDEX_PATH=                         # 扫描快照路径（不传则用内置默认）
# OPS_API_BASE_URL=                            # 脚本回打本服务的基址
# GITHUB_TOKEN=                                # 拉 GitHub 数据用；只给脚本，服务本身不需要

# --- 一次性：Supabase 历史导入 ---
# SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- 测试专用（**不要写进 .env**，只在跑 pytest 时用环境变量传） ---
# 换测试库**只能**用这个键，且库名必须合法标识符 + 以 `_test` 结尾，否则 conftest 在
# import 期直接抛错。刻意不复用 DATABASE_URL：.env 里那个指向**开发库**，
# 而 clean_sync_data 会 delete(OpsRepo)，五张表 ON DELETE CASCADE ⇒ 跑一次测试就删光真实导入数据。
# OPS_TEST_DATABASE_URL=postgresql+asyncpg://ops:ops_password@127.0.0.1:5432/opsdesk_test

# V1-E 策略包试点（缺省不设 = 不加载 · 现状零 diff）
# OPS_LLM_STRATEGY_PACK=app/llm/packs/llm_tiers.v0.yaml
