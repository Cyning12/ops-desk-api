# ops-desk-api 环境变量全集（复制为 .env 后填真实值，禁止提交 .env）
#
# 本地：`make dev` / uvicorn 直接读本文件（pydantic Settings + ``load_dotenv`` 进 os.environ）。
# tracing / reranker 用 os.getenv，必须靠 load_dotenv；只写进 Settings 不够。
# 生产：真值在服务器 `/opt/ops-desk/.env`，但容器只吃
#   ops-desk-workspace/deploy/docker-compose.prod.yml → api.environment 里声明过的键。
#   只改生产 .env、不改 compose 透传 = 容器里看不到。
# 生产示例另见：ops-desk-workspace/deploy/.env.example

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ops:ops_password@localhost:5432/opsdesk
# 生产 compose 用 DB_PASSWORD 拼 DATABASE_URL；本地 make dev 不需要这项
# DB_PASSWORD=

# --- Auth / Cookie ---
OPS_DESK_SECRET=change-me-in-production
OPS_DESK_AUTH_MODE=db
# SESSION_COOKIE_NAME=ops_session
# SESSION_TTL_HOURS=168
# 生产必须 true（HTTPS）；本地 false
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_PATH=/

# --- Admin sync（GHA 机读 Bearer） ---
# 空=仅 cookie maintainer；非空则 POST /api/ops/admin/sync 可用 Authorization: Bearer
OPS_ADMIN_SYNC_TOKEN=

# --- CORS ---
# 本地 Vue；生产 https://www.cynaya.cn
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chat ---
# 生产必须 false（未鉴权演示通道）
OPS_CHAT_WS_ENABLED=true

# --- LLM（Chat 默认） ---
OPS_LLM_PROVIDER=siliconflow
OPS_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-xxxxxxxx
BAILIAN_API_KEY=sk-xxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# --- RAG 向量 / Qdrant ---
# 本地默认 qdrant；生产切流前曾默认 pgvector，现网切读后为 qdrant
RAG_VECTOR_BACKEND=qdrant
RAG_QDRANT_SHADOW_WRITE=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ops_knowledge
# QDRANT_API_KEY=
# 查询期 HNSW ef（越小越快、召回略降）；未设时代码默认 30
# QDRANT_HNSW_EF=30

# --- RAG 关键词路 ---
RAG_FTS_CONFIG=simple
RAG_KW_EXPAND=false
# RAG_SECOND_PATH=fts
# RAG_SPARSE_MODEL=BAAI/bge-m3
# RAG_SPARSE_FP16=false

# --- RAG 查询嵌入（生产推荐远程，消本地 bge-m3 冷启动） ---
# siliconflow=远程 POST /embeddings（默认，含空/未设）；local=本机 SentenceTransformer（仅本机有内存时）
RAG_EMBED_BACKEND=siliconflow
# RAG_EMBED_MODEL=BAAI/bge-m3

# --- RAG 精排（生产推荐开；金样对照须关） ---
RAG_RERANK_ENABLED=true
# siliconflow=远程 POST /rerank（默认，含空/未设）；local=本机 CrossEncoder（仅本机有内存时）
RAG_RERANK_BACKEND=siliconflow
RAG_RERANK_MIN_SCORE=0.4
RAG_RERANK_SCORE_RATIO=0.75
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_RERANK_CANDIDATES=20

# --- RAG grader / LC Evidence answer ---
RAG_GRADER_PROMPT=v1
RAG_GRADER_PROVIDER=bailian
RAG_GRADER_MODEL=qwen3.7-flash
# RAG_LC_ANSWER_PROVIDER=siliconflow
# RAG_LC_ANSWER_MODEL=
# RAG_LC_ANSWER_PROMPT=v1

# --- HuggingFace（生产机访问不了 huggingface.co） ---
# 只写 .env 不够：compose 必须透传同名键。权重建议挂 volume，避免 recreate 再拉。
# 生产推荐镜像站；有本地缓存后可改 HF_HUB_OFFLINE=1
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=0
# HF_HOME=/root/.cache/huggingface

# --- Langfuse（可选；Chat / LC Evidence 共用 OPS_CHAT_TRACER） ---
# OPS_CHAT_TRACER=langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# 仓内键；会同步到 SDK 的 LANGFUSE_TRACING_ENVIRONMENT。默认 prod；本机请写 dev
LANGFUSE_ENV=prod
# LANGFUSE_TRACING=false
# 线上规则分采样率（0.0–1.0）；默认 0=关闭。见 docs/spec/agent-infra/eval/GUIDE_online_sample_annotation_v0.md
# OPS_EVAL_SCORE_SAMPLE_RATE=0

# --- Capability · 真 MCP client（U3；默认关 · CI 不外网） ---
# OPS_CAPABILITY_MCP_ENABLED=false
# OPS_CAPABILITY_MCP_ENDPOINT=http://127.0.0.1:8080/mcp
# OPS_CAPABILITY_MCP_DEFAULT_TOOL=echo

# --- 一次性：Supabase 历史导入 ---
# SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
