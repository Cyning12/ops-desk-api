# Database
DATABASE_URL=postgresql+asyncpg://ops:ops_password@localhost:5432/opsdesk

# Auth
OPS_DESK_SECRET=change-me-in-production
OPS_DESK_AUTH_MODE=db

# LLM Provider
OPS_LLM_PROVIDER=siliconflow

# SiliconFlow (default provider)
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPS_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# Bailian fallback
BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# CORS (for local dev, allow Vue dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase source DB (one-time historical import only; see docs/ops/supabase-import-guide.md)
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# RAG 向量后端（默认 qdrant；回退生产设 RAG_VECTOR_BACKEND=pgvector）
RAG_VECTOR_BACKEND=qdrant
RAG_QDRANT_SHADOW_WRITE=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ops_knowledge
# QDRANT_API_KEY=
# QDRANT_HNSW_EF=64
# FTS：生产用 simple（标准 pgvector 镜像无 zhparser）；勿设 chinese 除非已装扩展
# RAG_FTS_CONFIG=simple
# 金样对照须关 rerank：RAG_RERANK_ENABLED=false · compare_with=reports/r4-2.yaml
# 生产推荐 CE：RAG_RERANK_ENABLED=true · RAG_RERANK_MIN_SCORE=0.4 · RAG_RERANK_SCORE_RATIO=0.75
# RAG_GRADER_PROMPT=v1
