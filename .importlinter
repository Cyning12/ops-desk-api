    app.ops.lc_evidence_chain
    app.ops.structured_output
    app.ops.admin
    app.ops.auth
    app.ops.deps
    app.ops.security
    app.ops.prompts
ignore_imports =
    app.ops.chat.router -> app.ops.deps
    app.ops.session.summary -> app.ops.prompts
    app.ops.session.summary -> app.ops.prompts.render

[importlinter:contract:admin-outbound]
name = admin 允许 → db（capability/memory/deps 观测面白名单）
type = forbidden
allow_indirect_imports = True
source_modules =
    app.ops.admin
forbidden_modules =
    app.ops.lg_rag
    app.ops.strategy
    app.ops.prompts
    app.ops.skill_registry
