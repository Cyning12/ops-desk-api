    app.ops.lc_evidence_chain
    app.ops.structured_output
    app.ops.chat
    app.ops.session
    app.llm
    app.ops.auth
    app.ops.deps
    app.ops.security
    app.ops.capability
    app.ops.memory
ignore_imports =
    app.ops.admin.sync -> app.ops.deps
    app.ops.admin.capability -> app.ops.deps
    app.ops.admin.memory -> app.ops.deps
    app.ops.admin.capability -> app.ops.capability
    app.ops.admin.capability -> app.ops.capability.baseline
    app.ops.admin.capability -> app.ops.capability.budget
    app.ops.admin.capability -> app.ops.capability.circuit
    app.ops.admin.capability -> app.ops.capability.fallback
    app.ops.admin.capability -> app.ops.capability.idempotency
    # manifest 故障可见性（catalog 顶层两键 · catalog-manifest-errors-surface · 00 裁定授权）
    app.ops.admin.capability -> app.ops.capability.manifest
    app.ops.admin.capability -> app.ops.capability.metrics
    app.ops.admin.capability -> app.ops.capability.persistence
    app.ops.admin.capability -> app.ops.capability.receipts
    app.ops.admin.capability -> app.ops.capability.types
    app.ops.admin.memory -> app.ops.memory.service

